{
  "name": "cf-enhance-companion",
  "displayName": "CF Enhance · 本地评测与提交",
  "description": "切题同步样例与反馈、独立本地测试、手动交互窗口和网页自动提交。",
  "version": "0.7.0",
  "publisher": "Miaooo0O",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./extension.cjs",
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "可查看记录；提交代码、连接与运行样例需要信任工作区。"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miaooo0O/cf-enhance"
  },
  "contributes": {
    "commands": [
      {
        "command": "cfEnhance.show",
        "title": "CF Enhance: 打开测试与提交面板",
        "icon": "$(beaker)"
      },
      {
        "command": "cfEnhance.pair",
        "title": "CF Enhance: 配对浏览器"
      },
      {
        "command": "cfEnhance.submit",
        "title": "CF Enhance: 选择代码和题目并提交"
      },
      {
        "command": "cfEnhance.tasks",
        "title": "CF Enhance: 查看提交任务"
      },
      {
        "command": "cfEnhance.openProblem",
        "title": "CF Enhance: 在网页打开题目"
      },
      {
        "command": "cfEnhance.cancel",
        "title": "CF Enhance: 取消提交任务"
      },
      {
        "command": "cfEnhance.disconnect",
        "title": "CF Enhance: 断开并撤销浏览器配对"
      },
      {
        "command": "cfEnhance.copyCode",
        "title": "CF Enhance: 复制任务代码"
      },
      {
        "command": "cfEnhance.runSamples",
        "title": "CF Enhance: 用当前编辑器运行网页题目样例（C++）"
      }
    ],
    "views": {
      "cfEnhance": [
        {
          "id": "cfEnhance.control",
          "name": "测试与提交",
          "type": "webview"
        },
        {
          "id": "cfEnhance.tasks",
          "name": "提交记录",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "cfEnhance.show",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "CF Enhance",
      "properties": {
        "cfEnhance.port": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "0：自动选择空闲端口，记住当前工作区端口；被占用时自动换端口。也可指定 1024–65535，修改后重新加载 VS Code。"
        },
        "cfEnhance.compiler": {
          "type": "string",
          "default": "g++",
          "description": "本地样例测试使用的 C++ 编译器程序路径（不含额外参数）。"
        },
        "cfEnhance.cCompiler": {
          "type": "string",
          "default": "gcc",
          "description": "C 本地测试编译器程序路径，不含额外参数。"
        },
        "cfEnhance.python": {
          "type": "string",
          "default": "python",
          "description": "Python 本地测试解释器程序路径，不含额外参数。"
        },
        "cfEnhance.testTimeout": {
          "type": "integer",
          "default": 3000,
          "minimum": 100,
          "maximum": 30000,
          "description": "每个用例的本地运行时限（毫秒），编译限时 30 秒。"
        },
        "cfEnhance.outputComparison": {
          "type": "string",
          "enum": [
            "tokens",
            "exact"
          ],
          "default": "tokens",
          "enumDescriptions": [
            "按空白分隔后的内容逐项比较",
            "保留内部空白，只忽略行尾格式与末尾空白"
          ],
          "description": "本地测试的输出比较方式。"
        },
        "cfEnhance.interactiveTimeout": {
          "type": "integer",
          "default": 120000,
          "minimum": 1000,
          "maximum": 600000,
          "description": "手动交互会话的总时限（毫秒），包含等待回复时间。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cfEnhance",
          "title": "CF Enhance",
          "icon": "media/activity.svg"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test *.test.cjs"
  },
  "license": "MIT"
}
